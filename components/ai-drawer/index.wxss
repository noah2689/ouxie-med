/* AI 会话抽屉组件 */

.drawer-wrapper {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2000;
}

.drawer-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
}

.drawer-panel {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 560rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  box-shadow: -4rpx 0 24rpx rgba(0, 0, 0, 0.08);
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 88rpx 32rpx 24rpx;
  border-bottom: 1px solid #F0F0F2;
  flex-shrink: 0;
}

.drawer-title {
  font-size: 17px;
  font-weight: 600;
  color: #1A1A2E;
}

.drawer-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1px solid #D8D8E0;
  background: #F8F9FA;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 14px;
  color: #8E8E9A;
  line-height: 1;
}

.drawer-body {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 0;
}

.drawer-item {
  display: flex;
  align-items: stretch;
  padding: 24rpx 32rpx;
  border-bottom: 1px solid #F0F0F2;
}

.drawer-item-current {
  background: #F0F9F5;
}

.drawer-item-left {
  width: 12rpx;
  flex-shrink: 0;
  display: flex;
  align-items: stretch;
  margin-right: 20rpx;
}

.drawer-item-indicator {
  width: 6rpx;
  border-radius: 3rpx;
  background: transparent;
}

.indicator-active {
  background: #2EAB8A;
}

.drawer-item-body {
  flex: 1;
  min-width: 0;
}

.drawer-item-title {
  display: block;
  font-size: 14px;
  font-weight: 500;
  color: #1A1A2E;
  margin-bottom: 4rpx;
}

.drawer-item-summary {
  display: block;
  font-size: 12px;
  color: #8E8E9A;
  margin-bottom: 4rpx;
  line-height: 1.5;
}

.drawer-item-time {
  display: block;
  font-size: 11px;
  color: #B8B8C4;
}

.drawer-footer {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1px solid #F0F0F2;
  flex-shrink: 0;
}

.drawer-new-btn {
  height: 80rpx;
  border-radius: 16rpx;
  background: #2EAB8A;
  color: #FFFFFF;
  font-size: 14px;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
