/* 成员切换底部弹窗组件样式 */

.sheet-content {
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
}

/* ── 拖拽条 ── */
.sheet-handle {
  display: flex;
  justify-content: center;
  padding: 20rpx 0 12rpx;
  flex-shrink: 0;
}

.handle-bar {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #D8D8E0;
}

/* ── 标题区 ── */
.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 40rpx 24rpx;
  flex-shrink: 0;
}

.sheet-title {
  font-size: 16px;
  font-weight: 600;
  color: #1A1A2E;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1px solid #D8D8E0;
  background: #F8F9FA;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  font-size: 14px;
  color: #8E8E9A;
  line-height: 1;
}

/* ── 成员列表 ── */
.member-list {
  padding: 0 40rpx;
  flex: 1;
  overflow-y: auto;
}

.member-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1px solid #F0F0F2;
}

.member-item:last-of-type {
  border-bottom: none;
}

/* ── 头像 ── */
.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F8F9FA;
  color: #8E8E9A;
  border: 1.5px solid #E8E8EE;
  flex-shrink: 0;
}

.avatar-active {
  background: #E8F6F1;
  color: #2EAB8A;
  border-color: #2EAB8A;
}

.avatar-text {
  font-size: 15px;
  font-weight: 600;
}

/* ── 信息 ── */
.member-info {
  flex: 1;
  min-width: 0;
}

.member-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.member-name {
  font-size: 14px;
  font-weight: 500;
  color: #1A1A2E;
}

.member-relation {
  font-size: 11px;
  color: #8E8E9A;
}

.member-meta {
  display: block;
  font-size: 11px;
  color: #B8B8C4;
  line-height: 1.3;
}

/* ── 选中标识 ── */
.member-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2px solid #E8E8EE;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.check-active {
  background: #2EAB8A;
  border-color: #2EAB8A;
}

.check-mark {
  color: #FFFFFF;
  font-size: 12px;
  font-weight: 700;
}

/* ── 底部 ── */
.sheet-footer {
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1px solid #F0F0F2;
  display: flex;
  justify-content: center;
  flex-shrink: 0;
}

.footer-link {
  font-size: 13px;
  color: #8E8E9A;
}
