<!-- 瓯械健康 · 设备管理页 — Phase 6 -->
<scroll-view class="page" scroll-y>

  <!-- ═══ ① 顶部说明卡片 ═══ -->
  <view class="intro-card">
    <text class="intro-title">已连接设备</text>
    <text class="intro-desc">查看家庭健康设备的连接状态和数据同步情况</text>
    <view class="intro-stats">
      <view class="intro-stat">
        <text class="intro-stat-num">{{connectedCount}}</text>
        <text class="intro-stat-lbl">已连接</text>
      </view>
      <view class="intro-stat">
        <text class="intro-stat-num">{{pendingCount}}</text>
        <text class="intro-stat-lbl">待添加</text>
      </view>
    </view>
  </view>

  <!-- ═══ ② 已连接设备列表 ═══ -->
  <view class="section">
    <text class="section-title">已连接设备</text>
    <view class="device-card" wx:for="{{connectedDevices}}" wx:key="id">
      <view class="device-header">
        <view class="device-status-dot device-dot-{{item.statusLevel}}"></view>
        <view class="device-info">
          <text class="device-name">{{item.name}}</text>
          <text class="device-status-text">{{item.statusText}}</text>
        </view>
      </view>
      <view class="device-body">
        <text class="device-sync">数据同步正常</text>
        <text class="device-meta">最近同步：{{item.lastSyncText}}</text>
        <text class="device-meta">关联成员：本人</text>
      </view>
      <view class="device-actions">
        <view class="dev-btn dev-btn-outline" data-id="{{item.id}}" bindtap="onViewSyncRecords">查看同步记录</view>
        <view class="dev-btn dev-btn-brand" data-id="{{item.id}}" bindtap="onResyncDevice">重新同步</view>
      </view>
    </view>
  </view>

  <!-- ═══ ③ 推荐添加设备 ═══ -->
  <view class="section">
    <text class="section-title">推荐添加设备</text>
    <view class="rec-card" wx:for="{{recommendedDevices}}" wx:key="id">
      <view class="rec-body">
        <text class="rec-name">{{item.name}}</text>
        <text class="rec-desc">{{item.description}}</text>
        <text class="rec-reason">{{item.reason}}</text>
      </view>
      <view class="rec-btn" bindtap="onAddDevice">添加设备</view>
    </view>
  </view>

  <!-- ═══ ④ 设备说明 ═══ -->
  <view class="section">
    <view class="note-card">
      <text class="note-title">设备同步说明</text>
      <text class="note-body">设备数据仅用于记录展示，当前 Demo 使用本地 mock 数据模拟同步状态。</text>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</scroll-view>
